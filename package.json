{
  "name": "local-agent",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Local Agent (JARVIS) - a local-first, permission-controlled Windows desktop assistant. Phase 1.",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build:electron && vite build",
    "build:electron": "npm run build:main && npm run build:preload",
    "build:main": "tsc -p tsconfig.electron.json && node scripts/write-electron-package-json.mjs",
    "build:preload": "vite build --config vite.preload.config.ts",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "electron": "44.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
