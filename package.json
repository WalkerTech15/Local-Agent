{
  "name": "local-agent",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Local Agent (JARVIS) - a local-first, permission-controlled Windows desktop assistant.",
  "author": {
    "name": "Local Agent Project"
  },
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build:electron && vite build",
    "build:electron": "npm run build:main && npm run build:preload",
    "build:main": "tsc -p tsconfig.electron.json && node scripts/write-electron-package-json.mjs",
    "build:preload": "vite build --config vite.preload.config.ts",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "check:signing": "node scripts/check-signing-config.mjs",
    "check:update": "node scripts/check-update-config.mjs",
    "check:release": "node scripts/check-release-metadata.mjs",
    "package:win": "npm run check:signing && npm run check:update && npm run check:release && npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.11.5",
    "electron-builder": "26.18.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@electron/universal": "3.0.6",
    "minimatch": "11.0.9"
  }
}
