# Local Agent - example development environment file
#
# Copy to `.env` for local development. `.env` is git-ignored.
#
# ---------------------------------------------------------------------------
# THIS FILE MUST NEVER CONTAIN A SECRET.
#
# No API key, token, password, or credential belongs in this file, in `.env`,
# in any settings JSON file, or anywhere else in this repository.
#
# API keys are entered by the user in the application and stored encrypted at
# rest by the Electron main process using the asynchronous safeStorage API
# (Windows DPAPI). They are never written to the repository, never written to
# a settings file, never logged, and never sent to the renderer process.
#
# See docs/security-model.md for the full secret-handling policy.
# ---------------------------------------------------------------------------

# Log verbosity for development builds.
# One of: error | warn | info | debug
LOCAL_AGENT_LOG_LEVEL=info

# Set to "1" to print resolved user-data paths on startup (development aid).
LOCAL_AGENT_DEBUG_PATHS=0
